# ============================================================
#  Réglages d'Auto Shorts — remplis les lignes qui t'intéressent
#  (ne partage jamais ce fichier : il contient tes clés secrètes)
# ============================================================

# Clé de l'IA Claude (choix des meilleurs moments + titres/hashtags)
# À créer sur https://console.anthropic.com  -> « API Keys »
ANTHROPIC_API_KEY=

# Clés de ton application TikTok (voir le guide, partie TikTok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Précision de la transcription : tiny, base, small, medium, large-v3
# « small » = bon compromis. « medium » = plus précis mais plus lent.
WHISPER_MODEL=small

# Port de l'application (laisse 8000 sauf si tu sais pourquoi le changer)
PORT=8000
